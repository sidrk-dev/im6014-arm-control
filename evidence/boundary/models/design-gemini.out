### Data Structures & Exact Public Signatures

```python
# ==============================================================================
# motor_protocol.py
# ==============================================================================
from typing import Any, Protocol, runtime_checkable
import struct

# Protocol & reduction constants
RATIO: float = 38 / 3
HEADER_CMD: bytes = b'\xfe\xee'
HEADER_REPLY: bytes = b'\xfc\xee'
CMD_LEN: int = 20
REPLY_LEN: int = 26

RPM_MIN: float = -32768 / 64 / RATIO * 60
RPM_MAX: float = 32767 / 64 / RATIO * 60
POSITION_MIN: float = -2147483648 / 32768 / RATIO * 6.283185307179586
POSITION_MAX: float = 2147483647 / 32768 / RATIO * 6.283185307179586
PORT: str = '/dev/serial/by-id/usb-FTDI_USB__-__Serial_Converter_FTC2RQ7H-if03-port0'


class ProtocolError(RuntimeError):
    """Base error for communication boundary failures."""
    pass


class FrameCrcError(ProtocolError):
    """Frame failed CRC32 validation; retains 'CRC' in str for caller matching."""
    def __init__(self, message: str = "Feedback CRC mismatch"):
        super().__init__(message)


class DeadlineExceededError(ProtocolError):
    """Transaction exceeded monotonic budget; retains 'deadline' for caller matching."""
    def __init__(self, message: str = "No validated motor feedback within deadline"):
        super().__init__(message)


@runtime_checkable
class SerialTransport(Protocol):
    """Duck-typed transport interface matching pySerial and test fakes."""
    timeout: float | None
    write_timeout: float | None
    in_waiting: int

    def reset_input_buffer(self) -> None: ...
    def write(self, data: bytes) -> int: ...
    def read(self, size: int) -> bytes: ...


def crc32(data: bytes) -> int:
    """Compute vendor STM32/Unitree compatible CRC32 over 4-byte words."""
    // TODO: Validate len(data) % 4 == 0, apply polynomial 0x04C11DB7 with reversed word bytes
    raise NotImplementedError


def encode_command(
    motor_id: int,
    mode: int = 0,
    rpm: float = 0.0,
    kd: float = 0.0,
    torque: float = 0.0,
    watchdog: bool = True,
    position: float = 0.0,
    kp: float = 0.0,
) -> bytes:
    """Encode output-shaft targets into exact 20-byte command packet."""
    // TODO: Validate ID 0-14, mode 0-1, finite floats, bench limits (Kd 0-6, Kp 0-30, tau +/-3.5)
    // TODO: Pack feee + control fields + CRC32
    raise NotImplementedError


def decode_feedback(raw: bytes, expected_motor_id: int | None = None) -> dict[str, Any]:
    """Decode exact 26-byte frame into canonical feedback dictionary."""
    // TODO: Verify len == 26, raw[:2] == b'\xfc\xee', CRC32 matches
    // TODO: Unpack fields, check expected_motor_id and mode in (0, 1)
    // TODO: Return dict with id, mode, timeout, driver_c, winding_c, voltage, torque_nm, rpm, position_rad, errors, warnings, raw
    raise NotImplementedError


def validate_bench_health(
    feedback_dict: dict[str, Any],
    expected_mode: int,
    allow_timeout: bool = False,
    speed_limit: float = 0.0,
) -> None:
    """Apply bench safety envelope checks to decoded feedback."""
    // TODO: Check mode, errors == 0, warnings == 0, timeout gate, voltage 24-72V, temps, speed_limit
    raise NotImplementedError


class IM6014Transceiver:
    """Cohesive transaction engine managing streaming resync, deadlines, and framing."""

    def __init__(self, transport: Any, max_buffer_bytes: int = 256):
        self.transport: Any = transport
        self.max_buffer_bytes: int = max_buffer_bytes
        self._buffer: bytearray = bytearray()

    def exchange(self, packet: bytes, motor_id: int, deadline_s: float = 0.05) -> dict[str, Any]:
        """Execute one bounded synchronous exchange with full stream resynchronization."""
        // TODO: See detailed resynchronization algorithm below
        raise NotImplementedError

    def transact(
        self,
        motor_id: int,
        mode: int = 0,
        rpm: float = 0.0,
        kd: float = 0.0,
        torque: float = 0.0,
        watchdog: bool = True,
        position: float = 0.0,
        kp: float = 0.0,
        deadline_s: float = 0.05,
    ) -> dict[str, Any]:
        """High-level transaction encoding command and executing exchange."""
        packet = encode_command(motor_id, mode, rpm, kd, torque, watchdog, position, kp)
        return self.exchange(packet, motor_id, deadline_s)


# Backwards-compatibility aliases matching current spin_5rpm.py
command = encode_command
feedback = decode_feedback
healthy = validate_bench_health

def exchange(bus: Any, packet: bytes, motor_id: int, deadline_s: float = 0.05) -> dict[str, Any]:
    """Preserved functional entry point delegating to cohesive transceiver."""
    return IM6014Transceiver(bus).exchange(packet, motor_id, deadline_s)
```

---

### Stream Resynchronization Algorithm & Deadline Handling

The resynchronization algorithm specifically solves all five defects noted in Phase A grounding:

```mermaid
sequenceDiagram
    participant Caller
    participant Transceiver as IM6014Transceiver
    participant Bus as Serial / Fake Transport

    Caller->>Transceiver: exchange(packet, motor_id, deadline_s)
    Note over Transceiver: Record start_time, deadline = start_time + deadline_s<br/>Save orig_timeout, orig_write_timeout
    Transceiver->>Bus: reset_input_buffer()
    Note over Transceiver: Check remaining monotonic budget > 0
    Transceiver->>Bus: write(packet) [write_timeout capped to budget]
    
    loop While monotonic() < deadline
        Note over Transceiver: Cap bus.timeout = min(orig_timeout, remaining)
        Transceiver->>Bus: read(min(26, max(1, in_waiting)))
        Note over Transceiver: Append chunk to _buffer
        loop Scan _buffer for candidates
            alt Header b'\xfc\xee' not found
                Note over Transceiver: If last byte is 0xfc, keep it; else clear _buffer.<br/>(Prevents unbounded noise growth)
            else Header found at index `start`
                Note over Transceiver: Discard noise before `start`
                alt len(_buffer) < 26
                    Note over Transceiver: Break to outer read loop (wait for more bytes)
                else len(_buffer) >= 26
                    Note over Transceiver: Inspect candidate = _buffer[0:26]
                    alt CRC invalid OR motor_id mismatch OR mode invalid
                        Note over Transceiver: Discard 1 byte (_buffer[:1]) to check overlapping headers.<br/>Continue inner candidate scan.
                    else Valid CRC AND motor_id match AND mode valid
                        Note over Transceiver: Consume frame (_buffer[:26]).<br/>Restore timeouts in finally.<br/>Return decode_feedback(candidate)
                    end
                end
            end
        end
    end

    Note over Transceiver: Deadline expired! Restore timeouts in finally.
    Transceiver-->>Caller: raise DeadlineExceededError("...deadline... received: " + hex)
```

#### Pseudocode for Algorithm:
```python
def exchange(self, packet: bytes, motor_id: int, deadline_s: float = 0.05) -> dict[str, Any]:
    start_time = time.monotonic()
    deadline = start_time + deadline_s
    bus = self.transport

    # 1. Capture original timeouts
    orig_read_timeout = getattr(bus, 'timeout', None)
    orig_write_timeout = getattr(bus, 'write_timeout', None)

    try:
        # 2. Reset transport input and local buffer
        if hasattr(bus, 'reset_input_buffer'):
            bus.reset_input_buffer()
        self._buffer.clear()

        # 3. Monotonic budget check before write
        rem = deadline - time.monotonic()
        if rem <= 0:
            raise DeadlineExceededError("Transaction deadline expired before write")

        # Temporarily cap write timeout to deadline budget
        if orig_write_timeout is not None:
            bus.write_timeout = min(orig_write_timeout, max(0.0001, rem))

        written = bus.write(packet)
        if written != len(packet):
            raise RuntimeError(f"Incomplete serial write: {written}/{len(packet)} bytes")

        # 4. Stream read & candidate resynchronization loop
        accumulated_hex = bytearray()
        while time.monotonic() < deadline:
            rem = deadline - time.monotonic()
            if rem <= 0:
                break

            # Cap read timeout to remaining budget
            if orig_read_timeout is not None:
                bus.timeout = min(orig_read_read_timeout, max(0.0001, rem))

            to_read = min(26, max(1, getattr(bus, 'in_waiting', 1)))
            chunk = bus.read(to_read)
            if chunk:
                self._buffer.extend(chunk)
                accumulated_hex.extend(chunk)
                if len(self._buffer) > self.max_buffer_bytes:
                    del self._buffer[:-self.max_buffer_bytes]

            # Candidate scan inside accumulated buffer
            while True:
                idx = self._buffer.find(b'\xfc\xee')
                if idx < 0:
                    # Header absent: bound buffer by discarding all except trailing 0xfc
                    if len(self._buffer) > 0 and self._buffer[-1:] == b'\xfc':
                        self._buffer = bytearray(b'\xfc')
                    else:
                        self._buffer.clear()
                    break

                # Discard prefix noise before header
                if idx > 0:
                    del self._buffer[:idx]
                    idx = 0

                # Check if complete frame is available
                if len(self._buffer) < 26:
                    break  # Wait for subsequent reads

                candidate = bytes(self._buffer[:26])
                body = candidate[2:22]
                crc_calc = crc32(body)
                (crc_wire,) = struct.unpack('<I', candidate[22:])

                # Condition 1: CRC validation
                if crc_wire != crc_calc:
                    # Noise or damaged candidate; advance 1 byte to check overlapping headers
                    del self._buffer[:1]
                    continue

                # Condition 2: Motor ID and mode match
                m_byte = candidate[2]
                cand_id = m_byte & 15
                cand_mode = (m_byte >> 4) & 7

                if cand_id != motor_id or cand_mode not in (0, 1):
                    # Valid frame but foreign motor or unsupported mode; advance 1 byte
                    del self._buffer[:1]
                    continue

                # Condition 3: Valid target frame found within deadline
                if time.monotonic() >= deadline:
                    break

                del self._buffer[:26]
                return decode_feedback(candidate, expected_motor_id=motor_id)

        raise DeadlineExceededError(
            f"No validated motor feedback within deadline; received {accumulated_hex.hex()}"
        )
    finally:
        # Guarantee restoration of transport timeouts in all cases
        if orig_read_timeout is not None:
            bus.timeout = orig_read_timeout
        if orig_write_timeout is not None:
            bus.write_timeout = orig_write_timeout
```

