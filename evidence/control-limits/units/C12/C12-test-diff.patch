+    def test_deterministic_seeded_fuzz_four_constraint_invariants(self):
+        rng = random.Random(12345)
+        for iteration in range(50):
+            reduction = rng.choice((1.0, 2.0, 3.0, 4.0))
+            direction = rng.choice((-1, 1))
+            zero = rng.uniform(-1.0, 1.0)
+            mapping = JointMap(reduction, direction, zero)
+
+            q_min = rng.uniform(-3.0, -1.0)
+            q_max = rng.uniform(1.0, 3.0)
+            v_max = rng.uniform(0.5, 5.0)
+            a_max = rng.uniform(1.0, 20.0)
+            lead = rng.uniform(0.1, 1.0)
+
+            spec = JointSpec(
+                "J_fuzz", 0, mapping, q_min, q_max, v_max, a_max, lead, "fixture: fuzz"
+            )
+
+            # Random anchor
+            q_anchor = rng.uniform(q_min + 0.1, q_max - 0.1)
+            v_anchor = rng.uniform(-v_max, v_max)
+            anchor = JointTrajectoryReference(
+                q_rad=q_anchor,
+                position_step_velocity_rad_s=Fraction(round(v_anchor, 3)),
+                encoded_velocity_rad_s=v_anchor,
+                sample_time_s=10.0,
+                is_emitted=True,
+            )
+
+            # Random measurement and goal
+            q_meas = q_anchor + rng.uniform(-lead * 0.8, lead * 0.8)
+            goal_q = q_meas + rng.uniform(-lead * 1.5, lead * 1.5)
+            goal_v = rng.uniform(-v_max * 1.2, v_max * 1.2)
+            goal = JointTarget(goal_q, goal_v, 0.0, 1.0, 0.1)
+
+            h = rng.choice((0.01, 0.02, 0.05, 0.1))
+            now = 10.0 + h
+
+            code, emitted, ref, pkt = shape_reference_joint(
+                spec, goal, anchor, q_meas, now, 1.0
+            )
+
+            with self.subTest(iteration=iteration):
+                if code is None:
+                    self.assertIsNotNone(emitted)
+                    self.assertIsNotNone(ref)
+                    self.assertIsNotNone(pkt)
+                    # 1. Position bounds
+                    self.assertGreaterEqual(emitted.q_rad, spec.q_min_rad)
+                    self.assertLessEqual(emitted.q_rad, spec.q_max_rad)
+                    # 2. Speed bounds
+                    h_exact = Fraction(h)
+                    v_max_exact = Fraction(spec.v_max_rad_s)
+                    self.assertLessEqual(abs(ref.position_step_velocity_rad_s), v_max_exact)
+                    self.assertLessEqual(abs(Fraction(ref.encoded_velocity_rad_s)), v_max_exact)
+                    # 3. Acceleration bounds
+                    a_max_exact = Fraction(spec.a_max_rad_s2)
+                    self.assertLessEqual(
+                        abs(ref.position_step_velocity_rad_s - anchor.position_step_velocity_rad_s),
